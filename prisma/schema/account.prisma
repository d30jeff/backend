model Account {
  ID                  String    @id
  name                String
  description         String?
  balance             Decimal   @default(0.00) @db.Decimal(12, 2)
  excludeFromOverview Boolean?  @default(false)
  currencyID          String
  workspaceID         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  createdByUserID     String
  updatedByUserID     String?
  archivedAt          DateTime?

  CreatedBy    User          @relation(name: "AccountsCreated", fields: [createdByUserID], references: [ID], onDelete: Cascade)
  UpdatedBy    User?         @relation(name: "AccountsUpdated", fields: [updatedByUserID], references: [ID])
  Currency     Currency      @relation(fields: [currencyID], references: [ID])
  Transactions Transaction[]
  Workspace    Workspace     @relation(fields: [workspaceID], references: [ID], onDelete: Cascade)

  @@index([ID, balance, currencyID, workspaceID, createdAt, updatedAt])
}
