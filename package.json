{
  "name": "@d30jeff/backend",
  "version": "0.0.0",
  "description": "",
  "author": "Deojeff Lai",
  "files": [
    "types-dist"
  ],
  "main": "./types-dist/index.js",
  "types": "./types-dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./types-dist/index.d.ts",
      "import": "./types-dist/index.js",
      "require": "./types-dist/index.js"
    },
    "./admin": {
      "types": "./types-dist/apps/admin/src/admin.d.ts",
      "import": "./types-dist/apps/admin/src/admin.js",
      "require": "./types-dist/apps/admin/src/admin.js"
    },
    "./business": {
      "types": "./types-dist/apps/business/src/business.d.ts",
      "import": "./types-dist/apps/business/src/business.js",
      "require": "./types-dist/apps/business/src/business.js"
    },
    "./common": {
      "types": "./types-dist/libs/common/src/index.d.ts",
      "import": "./types-dist/libs/common/src/index.js",
      "require": "./types-dist/libs/common/src/index.js"
    },
    "./consumer": {
      "types": "./types-dist/apps/consumer/src/consumer.d.ts",
      "import": "./types-dist/apps/consumer/src/consumer.js",
      "require": "./types-dist/apps/consumer/src/consumer.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "build-types": "rimraf types-dist && tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "build-admin": "rimraf types-dist && tsc -p tsconfig.admin.json && tsc-alias -p tsconfig.admin.json",
    "build-common": "rimraf types-dist && tsc -p tsconfig.common.json && tsc-alias -p tsconfig.common.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/admin/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/admin/test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@changesets/cli": "^2.31.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.7.0",
    "@zenstackhq/orm": "^3.4.6",
    "@zenstackhq/schema": "^3.4.6",
    "axios": "^1.13.6",
    "change-case-all": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "envalid": "^8.1.1",
    "etag": "^1.8.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-useragent": "^2.1.0",
    "firebase-admin": "^13.8.0",
    "google-libphonenumber": "^3.2.44",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mailgun.js": "^13.0.0",
    "mime-types": "^3.0.2",
    "nanoid": "^5.1.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@deojeff/configs": "^2.5.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@zenstackhq/cli": "^3.4.6",
    "eslint": "9",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.7.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
